# Application Settings
APP_NAME=Tordo
APP_VERSION=1.0.0
DEBUG=false

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=licitaciones
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/licitaciones
# Sync URL for Alembic (psycopg2). Required when FastAPI uses asyncpg (postgresql+asyncpg://...)
# Leave blank to reuse DATABASE_URL.
DATABASE_URL_SYNC=

# CORS Origins (comma-separated)
# En producción, `*`: la API es pública y anónima, sin credenciales (ver
# docs/DESPLIEGUE.md). En local da igual: el navegador habla con el proxy de Next.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Lista blanca de `Host` del MCP (coma-separada). La protección contra DNS
# rebinding está encendida: un dominio que no esté aquí recibe 421 en /mcp/.
# En producción, añade el dominio público.
MCP_HOSTS_PERMITIDOS=localhost,127.0.0.1

# ── Límite por IP (toda /api/v1 y /mcp) ───────────────────────────────────────
# Peticiones por minuto y por IP. En memoria del proceso: vale con UN worker.
LIMITE_POR_MINUTO=60
# Secreto compartido entre el servidor de Next y la API. Va en las DOS partes,
# nunca con prefijo NEXT_PUBLIC_ (se inlinearía en el navegador) y sin valor por
# defecto. Con él, la API cree la IP del visitante que manda el proxy y exime los
# renderizados del servidor (SSR/ISR). Sin él, todo el tráfico del sitio cae en
# el cubo de la IP del servidor de Next. Genera uno con: openssl rand -hex 32
PROXY_SECRETO=
# ¿Viene la API detrás de un borde que REESCRIBE X-Forwarded-For (Railway)? Sólo
# entonces su primera entrada es la IP del cliente. En local, false: cualquiera
# podría escribirla. En Railway, true.
CONFIAR_X_FORWARDED_FOR=false

# Backend Configuration
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000
# URL del backend, SÓLO para el servidor de Next: el navegador habla con
# /api/proxy en el mismo origen y nunca ve esta dirección.
API_URL=http://localhost:8000
# Nombre del responsable en /terminos y /privacidad (servidor, se lee en el build).
# Fuera del repo a propósito; sin ella las páginas muestran el hueco a la vista.
RESPONSABLE_LEGAL=
# Donaciones (/apoyar), servidor, opcionales: un medio sin variable no se muestra.
# Las URL tienen que ser https. DONAR_TRANSFERENCIA es texto multilínea (banco,
# tipo y número de cuenta, nombre, RUT, correo) y NUNCA va en el HTML.
DONAR_MERCADO_PAGO_URL=
DONAR_GITHUB_SPONSORS_URL=
DONAR_TRANSFERENCIA=

# Repositorio público del código (/abierto#codigo). Servidor, se lee en el build.
# Sólo https. Vacía mientras el repo sea privado: «Código» no enlaza nada.
REPOSITORIO_URL=

# ETL Configuration
ETL_LOG_LEVEL=INFO
ETL_MAX_RETRIES=3
ETL_RETRY_DELAY=5

# Data Source URLs
MERCADO_PUBLICO_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=etl.log

# Mercado Público API
# Compra Ágil usa una API DISTINTA (api2.mercadopublico.cl, v2): el ticket viaja
# en una cabecera y tiene cuota diaria. Normalmente es el mismo ticket; vacío
# significa que esa ingesta no se intenta.
COMPRA_AGIL_TICKET=
MERCADO_PUBLICO_TICKET=your-ticket-here

# Latido de los cron (Healthchecks.io): la URL de ping de cada chequeo, sin
# barra final. `python -m etl.cron` manda /start, éxito y /fail. Vacía, la
# corrida avisa en el log y sigue — pero nadie se entera si el cron se para.
LATIDO_URL_FRECUENTE=
LATIDO_URL_SEMANAL=

# Revalidación de las páginas públicas desde los cron (etl/cron.py, Revalidador).
# La URL completa del endpoint de Next (p. ej. https://tordo.cl/api/revalidar) y
# un secreto compartido: EL MISMO valor en Vercel y en los dos cron de Railway
# (`openssl rand -hex 32`). Sin valor por defecto; vacías, los cron no revalidan
# y lo dicen en el log. Un fallo al revalidar no hace fallar la corrida.
REVALIDAR_URL=
REVALIDAR_SECRETO=

# Dónde viven los parquets entre corridas del cron semanal (etl/almacen.py).
# OBLIGATORIA y sin valor por defecto: «disco» en local, «r2» en Railway. Caer a
# disco sin querer reconstruiría el análisis sólo con los 3 meses recién bajados.
ETL_ALMACEN=disco
# Con ETL_ALMACEN=r2, las cuatro. Cloudflare → R2 → Manage API tokens.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Raíz de raw/, consolidated/ y analytics/. Vacía: etl/data del checkout.
ETL_DATA_DIR=

# Dónde deja el ETL los parquets de analytics. La API NO los lee —el BI sale de
# `analytics.*` en Postgres y el orden por relevancia de `ts_rank_cd`—; sólo lo
# usa el script que recaptura el golden master (backend/tests/golden/).
ANALYTICS_DATA_PATH=etl/data/analytics


# Feature Flags (true/false)
FEATURE_ANALYTICS=false

# Workers de uvicorn en el contenedor de la API. UNO, y no por memoria (cada
# worker son ~100 MB; `make medir-memoria`): el límite por IP vive en memoria de
# cada proceso, y con N workers el límite real es N veces el anunciado.
WEB_CONCURRENCY=1

# ── Observabilidad ────────────────────────────────────────────────────────────
# Entorno lógico: development | staging | production
ENVIRONMENT=development
# DSN de Sentry del BACKEND. Vacío = Sentry desactivado (por defecto en local y en tests).
SENTRY_DSN=
# DSN de Sentry del FRONTEND. Lleva NEXT_PUBLIC_ a propósito, al contrario que
# API_URL: para reportar un error del navegador, el navegador tiene que saber a
# dónde mandarlo. Un DSN sólo permite escribir eventos, no leerlos.
NEXT_PUBLIC_SENTRY_DSN=
# El entorno que el navegador etiqueta en sus eventos. Espeja ENVIRONMENT.
NEXT_PUBLIC_ENVIRONMENT=development
# Sólo para el BUILD: sin ellas el build funciona, pero las trazas del navegador
# llegan minificadas y no se pueden leer.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Identidad pública del frontend (también se inlinea en el BUILD) ───────────
# El nombre visible. Si no se pasa al construir la imagen, queda el de por
# defecto: el código nunca hardcodea la marca, pero el build sí la congela.
NEXT_PUBLIC_APP_NAME=Tordo
# Dominio propio. Es lo que resuelve las URLs relativas de las tarjetas de
# preview (`metadataBase`): mal puesto, no falla nada y los enlaces compartidos
# salen sin imagen.
NEXT_PUBLIC_SITE_URL=https://tordo.cl
# LOG_JSON=true emite una línea JSON por evento (producción).
# LOG_JSON=false emite texto plano legible (desarrollo).
LOG_JSON=false
