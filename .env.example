# Application Settings
APP_NAME=SaaS Licitaciones Públicas Chile
APP_VERSION=1.0.0
DEBUG=false

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=licitaciones
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/licitaciones

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Backend Configuration
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ETL Configuration
ETL_LOG_LEVEL=INFO
ETL_SCHEDULE_INTERVAL=3600
ETL_BATCH_SIZE=100
ETL_MAX_RETRIES=3
ETL_RETRY_DELAY=5
ETL_REQUESTS_PER_SECOND=1.0

# Data Source URLs
CHILECOMPRA_API_URL=
MERCADO_PUBLICO_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=etl.log

# Mercado Público API
MERCADO_PUBLICO_TICKET=F8537A18-6766-4DEF-9E59-426B4FEE2844

# Mercado Público API
MERCADO_PUBLICO_TICKET=F8537A18-6766-4DEF-9E59-426B4FEE2844
