# Application Settings
APP_NAME=Tordo
APP_VERSION=1.0.0
DEBUG=false

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=licitaciones
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/licitaciones
# Sync URL for Alembic (psycopg2). Required when FastAPI uses asyncpg (postgresql+asyncpg://...)
# Leave blank to reuse DATABASE_URL.
DATABASE_URL_SYNC=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Backend Configuration
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000
# URL del backend, SÓLO para el servidor de Next: el navegador habla con
# /api/proxy en el mismo origen y nunca ve esta dirección ni los tokens.
API_URL=http://localhost:8000

# ETL Configuration
ETL_LOG_LEVEL=INFO
ETL_SCHEDULE_INTERVAL=3600
ETL_BATCH_SIZE=100
ETL_MAX_RETRIES=3
ETL_RETRY_DELAY=5
ETL_REQUESTS_PER_SECOND=1.0

# Data Source URLs
CHILECOMPRA_API_URL=
MERCADO_PUBLICO_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=etl.log

# Mercado Público API
MERCADO_PUBLICO_TICKET=your-ticket-here

# Storage
# local — writes to LOCAL_STORAGE_PATH (dev without Docker)
# s3    — AWS S3 or MinIO (used inside Docker Compose automatically)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/tordo_docs
AWS_BUCKET=tordo-docs
AWS_REGION=us-east-1
# MinIO (S3-compatible dev store). Leave blank for real AWS.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
# Public URL used for presigned download links sent to the browser
S3_ENDPOINT_URL_PUBLIC=http://localhost:9000

# Estado Hábil (ChileCompra open data CSV URL)
ESTADO_HABIL_CSV_URL=

# ETL workspace (path visible to Celery worker)
ETL_WORKSPACE=/workspace

# Analytics — path to pre-computed parquet files (from etl/analytics/run_all.py)
ANALYTICS_DATA_PATH=etl/data/analytics

# Pasarela de pago (se activa con FEATURE_BILLING=true)
# "mercadopago" es la principal — el ICP paga con tarjetas locales que Stripe no
# acepta (docs/decisiones/0008-mercadopago-como-pasarela.md).
BILLING_PROVIDER=mercadopago

# MercadoPago. Los planes se crean una vez con POST /preapproval_plan y aquí
# van sus ids. El token distingue prueba de producción por sí mismo.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PLAN_PRO=
MERCADOPAGO_PLAN_PRO_ANNUAL=
MERCADOPAGO_PLAN_ENTERPRISE=

# Stripe. Se conserva como segunda implementación del puerto: es lo que impide
# que "cambiar de pasarela" vuelva a ser cirugía.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE=

# Google OAuth (activate by setting credentials from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Twilio WhatsApp
# For sandbox testing: get SID/token from https://console.twilio.com
# Users must join sandbox first: send "join <your-sandbox-word>" to whatsapp:+14155238886
# Then set FEATURE_WHATSAPP=true below and use POST /api/alerts/test-whatsapp to verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Feature Flags (true/false)
FEATURE_ANALYTICS=false
FEATURE_BILLING=false
FEATURE_ESTADO_HABIL=true
FEATURE_DOCUMENTOS=true
FEATURE_CHECKLIST=true
FEATURE_TFIDF=false
FEATURE_WHATSAPP=false
# Show/hide legacy /dashboard/analytics page (set false to redirect to /dashboard/bi)
ANALYTICS_ENABLED=true
# Flower Celery monitor port (Docker)
FLOWER_PORT=5555

# ── Observabilidad ────────────────────────────────────────────────────────────
# Entorno lógico: development | staging | production
ENVIRONMENT=development
# DSN de Sentry del BACKEND. Vacío = Sentry desactivado (por defecto en local y en tests).
SENTRY_DSN=
# DSN de Sentry del FRONTEND. Lleva NEXT_PUBLIC_ a propósito, al contrario que
# API_URL: para reportar un error del navegador, el navegador tiene que saber a
# dónde mandarlo. Un DSN sólo permite escribir eventos, no leerlos.
NEXT_PUBLIC_SENTRY_DSN=
# El entorno que el navegador etiqueta en sus eventos. Espeja ENVIRONMENT.
NEXT_PUBLIC_ENVIRONMENT=development
# Sólo para el BUILD: sin ellas el build funciona, pero las trazas del navegador
# llegan minificadas y no se pueden leer.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Identidad pública del frontend (también se inlinea en el BUILD) ───────────
# El nombre visible. Si no se pasa al construir la imagen, queda el de por
# defecto: el código nunca hardcodea la marca, pero el build sí la congela.
NEXT_PUBLIC_APP_NAME=Tordo
# Dominio propio. Es lo que resuelve las URLs relativas de las tarjetas de
# preview (`metadataBase`): mal puesto, no falla nada y los enlaces compartidos
# salen sin imagen.
NEXT_PUBLIC_SITE_URL=https://tordo.cl
# LOG_JSON=true emite una línea JSON por evento (producción).
# LOG_JSON=false emite texto plano legible (desarrollo).
LOG_JSON=false
